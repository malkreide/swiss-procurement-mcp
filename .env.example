# swiss-procurement-mcp — example configuration (ARCH-005)
#
# Copy to `.env` and adjust. `.env` is gitignored; this file is the checked-in
# template and must never contain a real value.
#
# This server needs no credentials: the simap.ch read endpoints it wraps are
# fully public. Every variable below is operational, not secret. The file
# exists so the configuration surface is discoverable in one place rather than
# spread across the README and the source.

# ---------------------------------------------------------------------------
# Transport
# ---------------------------------------------------------------------------

# stdio (default) for Claude Desktop and local clients; sse or streamable-http
# for a cloud deployment. Anything else falls back to stdio.
MCP_TRANSPORT=stdio

# HTTP transports only. Defaults to loopback — set 0.0.0.0 only inside a
# container or behind a proxy, never on a shared host (SEC-016).
# MCP_HOST=127.0.0.1
# HOST=127.0.0.1

# HTTP transports only.
# PORT=8000
# MCP_PORT=8000

# ---------------------------------------------------------------------------
# Browser clients (SDK-004)
# ---------------------------------------------------------------------------

# Comma-separated origins allowed to call the HTTP transports from a browser.
# Unset means no cross-origin browser access at all — deliberately fail-closed.
# `*` is accepted but logs a warning and disables credentials, because browsers
# reject a wildcard origin together with credentials.
# MCP_CORS_ORIGINS=https://client.example,https://other.example

# ---------------------------------------------------------------------------
# Logging (OBS-003 / OBS-004)
# ---------------------------------------------------------------------------

# Structured JSON goes to stderr; stdout carries the MCP protocol stream.
# One of DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
