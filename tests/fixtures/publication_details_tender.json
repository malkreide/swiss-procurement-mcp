  "procurement": {
    "orderDescription": {
      "de": "<p>Baumeisterarbeiten ausserorts, beinhaltend: Ankerarbeiten, Betonarbeiten, Betonsanierung, Entwässerungen, Belag.</p><p><br></p><p>Hauptkubaturen:</p><ul><li>Aushubarbeiten ca. 70 m3 lose</li><li>ungespannte permanente Anker ca. 1850 m</li><li>Beton ca. 180 m3</li><li>Schalung ca. 520 m2</li><li>Bewehrung ca. 16 t</li><li>Kiessand ca. 80 m3 lose</li><li>Belag ca. 70 t</li><li>Strassenentwässerung ca. 90 m</li><li>Schächte 6 Stk.</li><li>Leerrohr KSR ca. 100 m</li></ul>",
      "en": null,
      "fr": null,
      "it": null
    },
